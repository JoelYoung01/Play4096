# ========================================================
#   Build Time + Runtime Vars (add to GitHub Variables)
# ========================================================

# Git commit SHA baked into the app at build time (CI sets this automatically).
BUILD_VERSION=development

# Production health endpoint polled after deploy (GitHub Actions variable).
# Example: https://play-4096.com/api/health
# HEALTH_CHECK_URL=

# Mobile TestFlight API origin (GitHub Actions variable → EXPO_PUBLIC_API_URL).
# Example: https://play-4096.com  (origin only; app appends /api/v1)
# MOBILE_API_URL=

# URL for the database file.
DATABASE_URL=data/local.db


# ========================================================
#      Runtime Only (.env next to docker-compose)
# ========================================================

# Deployment Environment
ENVIRONMENT=development

# Used to pull image for docker-compose
IMAGE_URL=play4096:latest

# Secret key
# - Used to generate authentication tokens
SECRET_KEY=

# Stripe
STRIPE_PUBLIC_KEY=
STRIPE_PRIVATE_KEY=
STRIPE_PRICE_ID=
STRIPE_ENDPOINT_SECRET=

# Logging
# - Pino Pretty printing. Only enabled in dev. (set false to disable pretty printing in dev)
# - Log Full Request, false to condense request logs (nice for local dev)
PINO_PRETTY=
LOG_FULL_REQUEST=true

# Email Configuration
SMTP_SERVER=mail.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=your_email_username
SMTP_PASSWORD=your_email_password
FROM_EMAIL=noreply@yourdomain.com

# Mobile OAuth / StoreKit (optional in development)
# Apple Sign In audience = iOS bundle id (and Services ID if used on web).
APPLE_CLIENT_ID=com.joelyoung.4096
# Comma-separated extra Apple client ids (optional).
APPLE_CLIENT_IDS=
# Comma-separated Google OAuth client ids (iOS + web) accepted as ID-token aud.
# Include the same value as GitHub secret GOOGLE_IOS_CLIENT_ID (and web client if used).
GOOGLE_CLIENT_IDS=
# StoreKit non-consumable product that unlocks Pro (under the app bundle above).
APPLE_IAP_PRODUCT_ID=com.joelyoung.4096.pro
APPLE_IAP_BUNDLE_ID=com.joelyoung.4096
